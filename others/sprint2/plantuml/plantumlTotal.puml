@startuml

left to right direction

(Publicar plat) as PP
(Publicar menú) as PM
(Indicar horari disponibilitat) as IHD
(Xatejar client-cuiner) as CHA
(Acceptar proposta) as AP


Cuiner --> PP
Cuiner --> PM
Cuiner --> IHD
Cuiner --> CHA
Cuiner --> AP


(Consultar Menus) as CM
(Consultar Plats) as CPL
(Consultar Ingredients) as CIN
(Cosnultar Alèrgens) as CAL
(Consultar Cuiners) as CC
(Fer comanda) as FC
(Eliminar ingredients opcionals) as EIO
(Comprovar maxim 3 comandes) as CM3
(Reservar Comanda) as REC
(Pagar Comanda) as PG
(Escollir tipus entrega) as ETE
(Consultar Historial) as CHI
(Repetir Comanda) as RCO
(Valorar Comanda) as VC
(Proposar Plat) as PRP
(Gestionar subscripció) as GSU

Client --> CPL
Client --> CM
Cuiner --> CM
Cuiner --> CPL
Client --> CC
Client --> FC
CC --> Cuiner
FC --> Cuiner
Client --> PG
PG --> Cuiner
Client --> CHI
Client --> VC
Client --> PRP
Client --> CHA
Client --> GSU


CPL ..> CIN : <<include>>
CPL ..> CAL : <<include>>
FC .> EIO : <<include>>
FC .> CM3 : <<include>>
REC .> FC : <<extend>>
RCO .> FC : <<extend>>
FC .> ETE : <<include>>

actor "Repartidor" as Repartidor
actor "Google Maps" as Maps
actor "Sistema de pagaments" as Pagaments

rectangle "QueMenges - Gestió d'entregues" {

  usecase "Gestionar perfil\nde repartidor" as UC_Perfil
  usecase "Consultar entregues\ndisponibles" as UC_Consultar
  usecase "Entrega" as UC_Entrega
  usecase "Consultar dades\nde l'entrega" as UC_Dades
  usecase "Actualitzar estat\nde l'enviament" as UC_Estat
  usecase "Seguiment ubicació" as UC_Ubicacio
}

Repartidor --> UC_Perfil
Repartidor --> UC_Consultar
Repartidor --> UC_Entrega
Client --> UC_Ubicacio
PG -->Repartidor
UC_Ubicacio ..> UC_Estat : <<include>>
UC_Entrega .> UC_Ubicacio : <<include>>

Maps --> UC_Ubicacio
Pagaments --> PG

rectangle "QueMenges -  Funcions Generals" {

(Registrar-se) as RS
(Comprovar registre) as CR
(Crear Perfil) as CP
(Indicar Tipus Perfil) as ITP
(Modificar Perfil) as MP
(Donar-se de baixa) as DB
(Eliminar perfils) as EP
(Canviar idioma) as CI

}
Usuari --> RS
Usuari --> CP
Usuari --> MP
Usuari --> CI

Usuari --> DB

FC ..> CR : <<include>>
CP ..> ITP : <<include>>
DB ..> EP : <<include>>

Usuari <|-- Cuiner
Usuari <|-- Client
Usuari <|-- Repartidor
@enduml