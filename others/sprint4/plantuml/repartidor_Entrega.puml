@startuml
title CU: Entrega

actor Repartidor

boundary InterficieRepartidor
control GestorRepartidor

control GestorComanda

entity Entrega
entity Comanda
entity EstatEnviament
entity SeguimentUbicacio

Repartidor -> InterficieRepartidor : seleccionaEntregaAssignada(idEntrega)
InterficieRepartidor -> GestorRepartidor : iniciarEntrega(idEntrega)

GestorRepartidor -> Entrega : obtenirDadesEntrega(idEntrega)
Entrega --> GestorRepartidor : dadesEntrega

GestorRepartidor -> GestorComanda : consultarEstatComanda(idComanda)
GestorComanda -> Comanda : obtenirEstat(idComanda)
Comanda --> GestorComanda : estatComanda
GestorComanda --> GestorRepartidor : estatComanda

alt La comanda no està preparada
    GestorRepartidor --> InterficieRepartidor : mostraMissatge("La comanda encara no està preparada")

else La comanda està preparada
    Repartidor -> InterficieRepartidor : confirmaRecollida()
    InterficieRepartidor -> GestorRepartidor : registrarRecollida(idEntrega)

    GestorRepartidor -> EstatEnviament : actualitzarEstat("En camí")
    EstatEnviament --> GestorRepartidor : estatActualitzat

    GestorRepartidor -> SeguimentUbicacio : iniciarSeguiment(idEntrega)
    SeguimentUbicacio --> GestorRepartidor : seguimentIniciat

    GestorRepartidor --> InterficieRepartidor : mostraRutaEntrega()

    Repartidor -> InterficieRepartidor : confirmaEntrega()
    InterficieRepartidor -> GestorRepartidor : finalitzarEntrega(idEntrega)

    GestorRepartidor -> EstatEnviament : actualitzarEstat("Entregada")
    EstatEnviament --> GestorRepartidor : estatActualitzat

    GestorRepartidor -> Entrega : marcarComEntregada(idEntrega)
    Entrega --> GestorRepartidor : entregaActualitzada

    GestorRepartidor -> GestorComanda : marcarComandaEntregada(idComanda)
    GestorComanda -> Comanda : actualitzarEstat("Entregada")
    Comanda --> GestorComanda : comandaActualitzada
    GestorComanda --> GestorRepartidor : comandaEntregada

    alt No es pot confirmar l'entrega
        GestorRepartidor --> InterficieRepartidor : mostraMissatge("No s'ha pogut confirmar l'entrega")

    else Entrega confirmada
        GestorRepartidor --> InterficieRepartidor : mostraMissatge("Entrega confirmada correctament")
    end
end

@enduml